{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/download/latest.apk",
      "destination": "/public/download/latest.apk"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/parse",
      "destination": "/api/index.py"
    },
    {
      "source": "/gallery/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/screen/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/app/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
