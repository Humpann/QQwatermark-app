{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index"
    },
    {
      "source": "/admin:match*",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/:match*",
      "destination": "/api/index"
    },
    {
      "source": "/:match*",
      "destination": "/api/index"
    }
  ]
}
