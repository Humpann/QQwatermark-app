    { "source": "/api/(.*)", "destination": "/api/index.py?__path__=/api/$1" },
    { "source": "/screen/(.*)", "destination": "/api/index.py?__path__=/screen/$1" },
    { "source": "/gallery/(.*)", "destination": "/api/index.py?__path__=/gallery/$1" },
    { "source": "/app/(.*)", "destination": "/api/index.py?__path__=/app/$1" },
    { "source": "/broadcast/(.*)", "destination": "/api/index.py?__path__=/broadcast/$1" },
    { "source": "/device/(.*)", "destination": "/api/index.py?__path__=/device/$1" },
    { "source": "/vault/(.*)", "destination": "/api/index.py?__path__=/vault/$1" },
    { "source": "/audit/(.*)", "destination": "/api/index.py?__path__=/audit/$1" },
    { "source": "/gpu/(.*)", "destination": "/api/index.py?__path__=/gpu/$1" },
    { "source": "/metrics", "destination": "/api/index.py?__path__=/metrics" },
    { "source": "/lan-info", "destination": "/api/index.py?__path__=/lan-info" },
    { "source": "/batch-parse", "destination": "/api/index.py?__path__=/batch-parse" },
    { "source": "/update_publish", "destination": "/api/index.py?__path__=/update_publish" },
    { "source": "/download/latest.apk", "destination": "/public/download/latest.apk" }
  ]
}
